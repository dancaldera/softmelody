---
const links = [
  { href: "#products", label: "Products" },
  { href: "#services", label: "Services" },
  { href: "#about", label: "About" },
  { href: "#book", label: "Book a call" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav" id="nav">
  <div class="nav-pill">
    <a class="brand" href="#top" aria-label="Softmelody home">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="currentColor"></rect>
        <path d="M7 16h3l2-6 4 12 3-9 2 4.5 1.5-1.5H25" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Softmelody
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-right">
      <a class="nav-cta" href="https://app.softmelody.dev" target="_blank" rel="noopener">
        Go to app <span aria-hidden="true">↗</span>
      </a>
      <button
        class="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {
        links.map((l, i) => (
          <a href={l.href} style={`--i:${i}`}>
            <span class="idx">0{i + 1}</span>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-primary" href="https://app.softmelody.dev" target="_blank" rel="noopener">
      Go to app
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7M8 7h9v9"></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 60;
    pointer-events: none;
  }
  .nav-pill {
    pointer-events: auto;
    width: var(--wrap);
    margin-inline: auto;
    height: 56px;
    padding: 0 8px 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-radius: 14px;
    border: 1px solid transparent;
    transition:
      background 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .nav.scrolled .nav-pill,
  .nav.open .nav-pill {
    background: rgba(12, 12, 15, 0.75);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border-color: var(--line);
    box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.9);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .brand svg {
    width: 26px;
    height: 26px;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-links a {
    position: relative;
    font-size: 14px;
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 8px;
    transition:
      color 0.25s ease,
      background 0.25s ease;
  }
  .nav-links a:hover {
    color: var(--text);
    background: rgba(var(--fg-rgb), 0.06);
  }
  .nav-links a[aria-current="true"] {
    color: var(--text);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 16px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    background: var(--text);
    transition: background 0.25s ease;
  }
  .nav-cta:hover {
    background: #e4e4e7;
  }

  .menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .menu-btn span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.5px;
    background: var(--text);
    border-radius: 1px;
    transition:
      transform 0.35s var(--ease),
      top 0.35s var(--ease);
  }
  .menu-btn span:first-child {
    top: 16px;
  }
  .menu-btn span:last-child {
    top: 22px;
  }
  .nav.open .menu-btn span:first-child {
    top: 19px;
    transform: rotate(45deg);
  }
  .nav.open .menu-btn span:last-child {
    top: 19px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    padding: 108px 24px 40px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu nav a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.6s var(--ease) forwards;
    animation-delay: calc(var(--i) * 0.05s + 0.05s);
  }
  .mobile-menu .idx {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
  .mobile-menu .btn {
    align-self: stretch;
  }

  @media (max-width: 1020px) {
    .nav-links {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .nav-cta {
      display: none;
    }
    .nav-pill {
      padding-left: 16px;
    }
  }
</style>

<script>
  const nav = document.getElementById("nav")!;
  const menu = document.getElementById("mobile-menu")!;
  const menuBtn = nav.querySelector<HTMLButtonElement>(".menu-btn")!;

  const onScroll = () => nav.classList.toggle("scrolled", scrollY > 24);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setMenu = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.documentElement.style.overflow = open ? "hidden" : "";
  };
  menuBtn.addEventListener("click", () => setMenu(menu.hidden));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) setMenu(false);
  });
  matchMedia("(min-width: 1021px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  /* Light the nav link for whichever section is on screen. */
  const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>(".nav-links a")];
  const byId = new Map(navLinks.map((a) => [a.getAttribute("href")!.slice(1), a]));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const link = byId.get(e.target.id);
        if (e.isIntersecting) {
          navLinks.forEach((a) => a.removeAttribute("aria-current"));
          link?.setAttribute("aria-current", "true");
        } else {
          link?.removeAttribute("aria-current");
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });
</script>
