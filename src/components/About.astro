---
import { products } from "../data/products";

const names = products.map((p) => p.name).join(", ");
---

<section id="about">
  <div class="wrap about">
    <aside class="meta reveal">
      <div class="sec-tag"><span class="led"></span>About <b>/ 03</b></div>
      <div class="mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M7 16h3l2-6 4 12 3-9 2 4.5 1.5-1.5H25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <div class="name">Softmelody</div>
      <div class="role">AI consultancy &amp; product studio</div>
      <div class="loc">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Remote-first, worldwide
      </div>
    </aside>

    <p class="statement reveal" style="--d:.08s">
      An independent consultancy building production AI for{" "}
      <strong>fintech, medtech, and communications.</strong> Every product on this page — {names} — is
      designed, built, and maintained under Softmelody, and the same engineering standard goes into{" "}
      <strong>your engagement.</strong>
    </p>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }
  .meta {
    position: sticky;
    top: calc(var(--nav-h) + 40px);
  }
  .mark {
    width: 64px;
    height: 64px;
    margin-top: 36px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    color: var(--text);
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .mark svg {
    width: 34px;
    height: 34px;
  }
  .name {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-top: 22px;
  }
  .role {
    font-size: 14px;
    color: var(--muted);
    margin-top: 6px;
  }
  .loc {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--faint);
    margin-top: 16px;
  }

  .statement {
    font-size: clamp(24px, 2.8vw, 38px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--faint);
    text-wrap: pretty;
  }
  .statement strong {
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .meta {
      position: static;
    }
  }
</style>
