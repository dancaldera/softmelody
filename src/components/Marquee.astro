<div class="marquee" aria-hidden="true">
  <div class="marquee-track" id="marquee-track">
    <span class="marquee-item">Voice AI Agents</span>
    <span class="marquee-item">Identity &amp; Security</span>
    <span class="marquee-item">Applied Machine Learning</span>
    <span class="marquee-item">Desktop Applications</span>
    <span class="marquee-item">Data Infrastructure</span>
