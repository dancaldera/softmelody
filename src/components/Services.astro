---
const services = [
  {
    num: "01",
    title: "Voice AI & Agents",
    desc: "Inbound/outbound voice agents, call workflows, and speech pipelines that hold up under real traffic.",
  },
  {
    num: "02",
    title: "AI Security & Identity",
    desc: "Verification flows, document pipelines, and credential security with AI woven in safely.",
  },
  {
    num: "03",
    title: "Product Engineering",
    desc: "Full-stack web apps, cross-platform desktop software, and the data infrastructure underneath.",
  },
  {
    num: "04",
    title: "AI Strategy & Integration",
    desc: "Pragmatic roadmaps: where AI genuinely pays off in your product, then building it.",
  },
];
---

<section id="services" style="padding-top:20px">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-tag">Consulting</div>
      <h2 class="sec-title">What Softmelody builds for you.</h2>
      <p class="sec-sub">
        Senior, hands-on engagements — from first architecture sketch to production deployment.
      </p>
    </div>
    <div class="svc-grid">
      {
        services.map((s, i) => (
          <div class="svc reveal" style={`--d:${i * 0.07}s`}>
            <div class="svc-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .svc {
    padding: 28px 24px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s;
    position: relative;
    overflow: hidden;
  }
  .svc:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 124, 255, 0.4);
  }
  .svc-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }
  .svc h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    margin: 40px 0 10px;
    letter-spacing: -0.01em;
  }
  .svc p {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.65;
  }
  .svc::after {
    content: "";
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
    border-radius: 2px;
  }
  .svc:hover::after {
    transform: scaleX(1);
  }
  @media (max-width: 1000px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
