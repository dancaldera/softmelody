<section id="book" style="padding-top:20px">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-tag">Consultation</div>
      <h2 class="sec-title">Schedule a consultation.</h2>
      <p class="sec-sub">
        Choose a time on the calendar, speak with our AI voice agent in your browser, or call to
        book by phone.
      </p>
    </div>
    <div class="phone-card reveal">
      <a class="phone-booking" href="tel:+14159412580">
        <span class="phone-label">Book with our AI voice agent</span>
        <span class="phone-number">+1 (415) 941-2580</span>
        <span class="phone-action">Call to book →</span>
      </a>
      <p class="agent-instruction">
        Prefer to talk here? Use the <strong>Talk to Melody</strong> button in the bottom-right corner
        to book directly from this page.
      </p>
    </div>
    <div class="cal-shell reveal">
      <span class="cal-loading">Loading availability…</span>
      <div id="cal-embed"></div>
    </div>
  </div>
</section>

<button
  class="agent-launcher"
  type="button"
  aria-haspopup="dialog"
  aria-controls="agent-dialog"
  aria-expanded="false"
>
  <span class="agent-pulse" aria-hidden="true"></span>
  Talk to Melody
</button>

<dialog class="agent-dialog" id="agent-dialog" aria-labelledby="agent-dialog-title">
  <div class="agent-dialog-head">
    <div>
      <div class="sec-tag">Voice agent</div>
      <h2 id="agent-dialog-title">Book with Melody</h2>
    </div>
    <button class="agent-close" type="button" aria-label="Close voice agent">×</button>
  </div>
  <iframe
    class="agent-embed"
    src="https://app.softmelody.dev/embed/agents/99ea43c5-9498-45fd-af9e-db7d32050eab"
    title="Melody voice agent"
    allow="microphone; autoplay"
  ></iframe>
</dialog>

<style>
  .phone-card {
    margin-bottom: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-2);
    overflow: hidden;
  }
  .phone-booking {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 24px;
    padding: 22px 24px;
    transition: background 0.2s;
  }
  .phone-booking:hover {
    background: rgba(30, 58, 138, 0.04);
  }
  .phone-label {
    font-size: 15px;
    font-weight: 600;
  }
  .phone-number {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--muted);
  }
  .phone-action {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .agent-instruction {
    margin: 0;
    padding: 16px 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .agent-instruction strong {
    color: var(--text);
    font-weight: 600;
  }
  .cal-shell {
    position: relative;
    width: 100%;
    height: 680px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-2);
    overflow: hidden;
  }
  .agent-launcher {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 12px 32px rgba(11, 11, 15, 0.22);
    font: 600 14px var(--font-body);
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .agent-launcher::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      110deg,
      transparent 20%,
      rgba(255, 255, 255, 0.08) 38%,
      rgba(255, 255, 255, 0.42) 50%,
      rgba(255, 255, 255, 0.08) 62%,
      transparent 80%
    );
    content: "";
    transform: translateX(-130%);
    animation: agent-shimmer 3.2s ease-in-out infinite;
  }
  .agent-launcher:hover {
    background: #1f2430;
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(11, 11, 15, 0.28);
  }
  .agent-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.16);
  }
  @keyframes agent-shimmer {
    0%,
    58% {
      transform: translateX(-130%);
    }
    100% {
      transform: translateX(130%);
    }
  }
  .agent-dialog {
    position: fixed;
    inset: auto 24px 88px auto;
    width: min(440px, calc(100vw - 32px));
    max-width: none;
    height: min(720px, calc(100dvh - 112px));
    max-height: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg);
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.24);
    overflow: hidden;
  }
  .agent-dialog::backdrop {
    background: rgba(15, 23, 42, 0.12);
  }
  .agent-dialog[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .agent-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }
  .agent-dialog-head h2 {
    margin: 6px 0 0;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .agent-close {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg-2);
    color: var(--text);
    font-size: 25px;
    line-height: 1;
    cursor: pointer;
  }
  .agent-embed {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    border: 0;
  }
  .cal-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  #cal-embed {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .agent-launcher::before {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .phone-booking {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .agent-launcher {
      right: 16px;
      bottom: 16px;
    }
    .agent-dialog {
      inset: 8px;
      width: auto;
      height: auto;
      border-radius: 14px;
    }
    .cal-shell {
      height: 720px;
    }
  }
</style>

<script>
  const CAL_LINK = "dancaldera/30-min";
  const w = window as any;

  (function (C: any, A: any, L: any) {
    let p = function (a: any, ar: any) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api: any = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(w, "https://app.cal.com/embed/embed.js", "init");

  w.Cal("init", "book", { origin: "https://app.cal.com" });
  w.Cal.ns.book("inline", {
    elementOrSelector: "#cal-embed",
    config: { layout: "month_view" },
    calLink: CAL_LINK,
  });
  w.Cal.ns.book("ui", {
    theme: "light",
    layout: "month_view",
    cssVarsPerTheme: { light: { "cal-brand": "#1e3a8a" } },
  });

  const agentDialog = document.querySelector<HTMLDialogElement>("#agent-dialog");
  const agentLauncher = document.querySelector<HTMLButtonElement>(".agent-launcher");
  const agentClose = document.querySelector<HTMLButtonElement>(".agent-close");

  agentLauncher?.addEventListener("click", () => agentDialog?.showModal());
  agentClose?.addEventListener("click", () => agentDialog?.close());
  agentDialog?.addEventListener("click", (event) => {
    if (event.target === agentDialog) agentDialog.close();
  });
  agentDialog?.addEventListener("toggle", () => {
    agentLauncher?.setAttribute("aria-expanded", String(agentDialog.open));
  });
</script>
