---
import { productStats } from "../data/products";

const pad = (n: number) => String(n).padStart(2, "0");

const facts = [
  { label: "Products shipped", value: pad(productStats.total) },
  { label: "Live in production", value: pad(productStats.live) },
  { label: "Industries", value: "Fintech · Medtech · Communications" },
  { label: "Engagement", value: "Strategy → Production" },
];
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="eyebrow rise" style="--d:.05s">
      <span class="led"></span>AI consultancy &amp; product engineering
    </div>

    <h1 class="display rise" style="--d:.12s">
      Enterprise-grade AI,<br />
      <em>engineered to ship.</em>
    </h1>

    <p class="hero-sub rise" style="--d:.24s">
      Softmelody is an independent AI consultancy designing and building production AI systems
      for fintech, medtech, and communications — from voice agents to identity infrastructure,
      strategy through shipped product.
    </p>

    <div class="hero-ctas rise" style="--d:.34s">
      <a class="btn btn-primary" href="#book">
        Book a consultation
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn btn-ghost" href="https://app.softmelody.dev" target="_blank" rel="noopener">
        Go to app
      </a>
    </div>

    <dl class="facts rise" style="--d:.46s">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--nav-h) + clamp(56px, 11vh, 128px)) 0 clamp(72px, 10vh, 112px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  /* A fine engineering grid that fades out from the top, with one soft light behind the headline. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(50% 45% at 30% 20%, rgba(var(--accent-rgb), 0.1), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 64px 64px;
    -webkit-mask-image: radial-gradient(90% 80% at 40% 0%, #000 30%, transparent 85%);
    mask-image: radial-gradient(90% 80% at 40% 0%, #000 30%, transparent 85%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: rgba(var(--fg-rgb), 0.03);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 8.4vw, 96px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    margin-top: 28px;
    max-width: 14ch;
  }

  .hero-sub {
    max-width: 60ch;
    margin-top: 28px;
    font-size: clamp(16.5px, 1.4vw, 19px);
    color: var(--muted);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
  }

  .facts {
    display: grid;
    grid-template-columns: 0.7fr 0.7fr 1.4fr 1fr;
    margin-top: clamp(64px, 10vh, 104px);
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: 22px 24px 0 0;
  }
  .facts div + div {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .facts dd {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div,
    .facts div + div {
      padding: 20px 16px 20px 0;
      border-left: 0;
    }
    .facts div:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .hero-ctas .btn {
      flex: 1 1 auto;
    }
  }
</style>
