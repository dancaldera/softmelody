<section class="hero">
  <canvas id="neural" aria-hidden="true"></canvas>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="eyebrow rise" style="--d:.05s">
      <span class="dot"></span>Softmelody · AI Consultancy &amp; Products
    </div>
    <h1 class="rise" style="--d:.15s">
      Enterprise-grade <span class="grad-text">AI</span>,<br />
      engineered to ship<br />
      <span class="rotator" id="rotator"><span>voice agents.</span></span>
    </h1>
    <p class="hero-sub rise" style="--d:.3s">
      Softmelody is the independent consultancy of <strong>Daniel Caldera</strong> — designing
      and building production AI systems for fintech, medtech, and communications. From voice
      agents to identity infrastructure: strategy through shipped product.
    </p>
    <div class="hero-ctas rise" style="--d:.45s">
      <a class="btn btn-primary" href="mailto:d@softmelody.dev?subject=Project%20inquiry%20—%20Softmelody">
        Start a project
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn btn-ghost" href="#products">Explore the products</a>
    </div>
    <div class="hero-stats rise" style="--d:.6s">
      <div class="stat"><b><i data-count="5">0</i></b><span>products shipped</span></div>
      <div class="stat"><b><i data-count="3">0</i></b><span>industries served</span></div>
      <div class="stat"><b><i data-count="100">0</i>+</b><span>open-source repos</span></div>
      <div class="stat"><b><i>1</i></b><span>founder, end to end</span></div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-h) + 60px) 0 80px;
  }
  #neural {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.85;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 35%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 35%, black 30%, transparent 75%);
  }
  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 180px;
    z-index: 1;
    background: linear-gradient(transparent, var(--bg));
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    backdrop-filter: blur(8px);
  }
  .eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan);
    animation: pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 7.2vw, 88px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 26px 0 0;
    max-width: 14ch;
  }

  .rotator {
    display: inline-block;
    position: relative;
    color: var(--violet);
    min-width: 6ch;
  }
  .rotator span {
    display: inline-block;
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease),
      filter 0.45s var(--ease);
  }
  .rotator span.out {
    opacity: 0;
    transform: translateY(-0.55em);
    filter: blur(6px);
  }

  .hero-sub {
    max-width: 560px;
    margin-top: 26px;
    font-size: 18px;
    color: var(--muted);
    line-height: 1.65;
  }
  .hero-sub strong {
    color: var(--text);
    font-weight: 500;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    margin-top: 64px;
    border-top: 1px solid var(--line);
  }
  .stat {
    padding: 22px 40px 0 0;
    margin-right: 40px;
    border-right: 1px solid var(--line);
  }
  .stat:last-child {
    border-right: 0;
    margin-right: 0;
  }
  .stat b {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .stat b i {
    font-style: normal;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat span {
    font-size: 13px;
    color: var(--faint);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    #neural {
      display: none;
    }
  }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- hero word rotator ---------- */
  const words = ["voice agents.", "identity AI.", "intelligent POS.", "production ML.", "real products."];
  const rotator = document.getElementById("rotator");
  let wi = 0;
  if (!reduced && rotator?.firstElementChild) {
    setInterval(() => {
      const span = rotator.firstElementChild!;
      span.classList.add("out");
      setTimeout(() => {
        wi = (wi + 1) % words.length;
        span.textContent = words[wi]!;
        span.classList.remove("out");
      }, 460);
    }, 3000);
  }

  /* ---------- stat counters ---------- */
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const cio = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        cio.unobserve(e.target);
        const el = e.target as HTMLElement;
        const target = Number(el.dataset.count);
        if (reduced) {
          el.textContent = String(target);
          continue;
        }
        const t0 = performance.now();
        const dur = 1400;
        const tick = (t: number) => {
          const p = Math.min((t - t0) / dur, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.6 },
  );
  counters.forEach((c) => cio.observe(c));

  /* ---------- neural canvas ---------- */
  const canvas = document.getElementById("neural") as HTMLCanvasElement | null;
  const hero = canvas?.parentElement;
  if (!reduced && canvas && hero) {
    const ctx = canvas.getContext("2d")!;
    let W = 0;
    let H = 0;
    let visible = true;
    let nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = hero!.offsetWidth;
      H = hero!.offsetHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      canvas!.style.width = `${W}px`;
      canvas!.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(90, Math.floor((W * H) / 16000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.6,
      }));
    }

    function frame() {
      requestAnimationFrame(frame);
      if (!visible) return;
      ctx.clearRect(0, 0, W, H);
      const linkD = 130;
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -20) n.x = W + 20;
        if (n.x > W + 20) n.x = -20;
        if (n.y < -20) n.y = H + 20;
        if (n.y > H + 20) n.y = -20;
        const dx = n.x - mouse.x;
        const dy = n.y - mouse.y;
        const d = Math.hypot(dx, dy);
        if (d < 140 && d > 0.1) {
          n.x += (dx / d) * 0.6;
          n.y += (dy / d) * 0.6;
        }
      }
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i]!;
          const b = nodes[j]!;
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < linkD) {
            ctx.strokeStyle = `rgba(139,124,255,${(1 - d / linkD) * 0.16})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      ctx.fillStyle = "rgba(180,170,255,0.55)";
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    hero.addEventListener("mousemove", (e) => {
      const r = hero.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    });
    hero.addEventListener("mouseleave", () => {
      mouse.x = mouse.y = -9999;
    });
    new IntersectionObserver(([e]) => {
      visible = e!.isIntersecting;
    }).observe(hero);
    document.addEventListener("visibilitychange", () => {
      visible = !document.hidden;
    });
    addEventListener("resize", resize, { passive: true });
    resize();
    frame();
  }
</script>
