<style>
  .contact {
    padding-bottom: 140px;
  }
  .contact-box {
    position: relative;
    border-radius: 28px;
    padding: 72px 56px;
    border: 1px solid var(--line-2);
    background:
      radial-gradient(700px 300px at 20% -10%, rgba(139, 124, 255, 0.16), transparent 60%),
      radial-gradient(600px 300px at 85% 110%, rgba(79, 216, 232, 0.1), transparent 60%),
      var(--bg-2);
    overflow: hidden;
    text-align: center;
  }
  .contact-box::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black, transparent 80%);
    pointer-events: none;
  }
  h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .contact-sub {
    color: var(--muted);
    max-width: 480px;
    margin: 18px auto 0;
    font-size: 16px;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7ef0c2;
    margin-bottom: 26px;
  }
  .avail::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7ef0c2;
    box-shadow: 0 0 12px #7ef0c2;
    animation: pulse 2s infinite;
  }

  .mail-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 38px;
    flex-wrap: wrap;
  }
  .mail-link {
    font-family: var(--font-mono);
    font-size: clamp(17px, 3vw, 24px);
    font-weight: 500;
    color: var(--text);
    padding: 16px 30px;
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: rgba(0, 0, 0, 0.3);
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.3s var(--ease);
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .mail-link:hover {
    border-color: rgba(139, 124, 255, 0.6);
    box-shadow: 0 0 36px rgba(139, 124, 255, 0.22);
    transform: translateY(-2px);
  }
  .mail-link svg {
    width: 20px;
    height: 20px;
    stroke: var(--violet);
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    padding: 16px 22px;
    border-radius: 14px;
    cursor: pointer;
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .copy-btn:hover {
    color: var(--text);
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .copy-btn.copied {
    color: #7ef0c2;
    border-color: rgba(126, 240, 194, 0.4);
  }
  .copy-btn svg {
    width: 15px;
    height: 15px;
  }

  .contact-form {
    display: flex;
    gap: 10px;
    max-width: 560px;
    margin: 30px auto 0;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .contact-form input {
    flex: 1 1 200px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text);
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.3);
    outline: none;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .contact-form input:focus {
    border-color: rgba(139, 124, 255, 0.6);
    box-shadow: 0 0 0 3px rgba(139, 124, 255, 0.15);
  }
  .contact-form input::placeholder {
    color: var(--faint);
  }
  .contact-form .btn {
    padding: 14px 24px;
    font-size: 14px;
    border: 0;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 44px;
    position: relative;
    z-index: 1;
  }
  .social {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    transition:
      color 0.3s,
      border-color 0.3s,
      transform 0.35s var(--ease),
      box-shadow 0.3s;
  }
  .social:hover {
    color: var(--text);
    border-color: rgba(139, 124, 255, 0.55);
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
  }
  .social svg {
    width: 19px;
    height: 19px;
  }
</style>

<script>
  const EMAIL = "d@softmelody.dev";

  const copyBtn = document.getElementById("copy-email");
  const copyLabel = document.getElementById("copy-label");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(EMAIL);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = EMAIL;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
    copyBtn.classList.add("copied");
    if (copyLabel) copyLabel.textContent = "Copied";
    setTimeout(() => {
      copyBtn.classList.remove("copied");
      if (copyLabel) copyLabel.textContent = "Copy";
    }, 2200);
  });

  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(e.target as HTMLFormElement);
    const name = String(data.get("name") ?? "").trim();
    const idea = String(data.get("idea") ?? "").trim();
    const subject = encodeURIComponent(`Project inquiry${name ? ` — ${name}` : ""}`);
    const body = encodeURIComponent(
      `Hi Daniel,\n\n${idea || "I'd like to talk about a project."}\n\n— ${name}`,
    );
    location.href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
  });
</script>
