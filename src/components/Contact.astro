<style>
  .contact {
    padding-bottom: 120px;
  }
  /* The one inverted block on the page: ivory paper, ink type. */
  .paper {
    position: relative;
    overflow: hidden;
    border-radius: 36px;
    padding: clamp(56px, 8vw, 112px) clamp(24px, 6vw, 96px) clamp(48px, 6vw, 80px);
    color: var(--ink);
    background:
      radial-gradient(60% 70% at 85% 0%, rgba(255, 182, 92, 0.55), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgba(255, 122, 82, 0.18), transparent 70%),
      var(--paper);
    text-align: center;
  }
  .paper ::selection {
    background: var(--ink);
    color: var(--paper);
  }
  .staff {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    width: 100%;
    height: 120px;
    pointer-events: none;
  }
  .staff path {
    fill: none;
    stroke: var(--paper-line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .paper > *:not(.staff) {
    position: relative;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--paper-line);
    background: rgba(255, 255, 255, 0.35);
  }
  .avail .led {
    background: #1f9d55;
    box-shadow: 0 0 0 3px rgba(31, 157, 85, 0.18);
    animation: breathe 2.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.4;
    }
  }
  h2 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: clamp(40px, 7.4vw, 108px);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin-top: 30px;
    text-wrap: balance;
  }
  h2 em {
    font-style: italic;
  }
  .contact-sub {
    color: var(--ink-muted);
    max-width: 500px;
    margin: 26px auto 0;
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .inline-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(21, 18, 14, 0.35);
    transition: text-decoration-color 0.2s ease;
  }
  .inline-link:hover {
    text-decoration-color: var(--ink);
  }

  .mail-row {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 10px;
    margin-top: 44px;
    flex-wrap: wrap;
  }
  .mail-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: clamp(17px, 2.6vw, 26px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--paper);
    padding: 20px 34px;
    border-radius: 999px;
    background: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s ease;
  }
  .mail-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 40px -18px rgba(21, 18, 14, 0.7);
  }
  .mail-link svg {
    width: 22px;
    height: 22px;
    color: var(--accent);
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    padding: 0 26px;
    min-height: 56px;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid rgba(21, 18, 14, 0.3);
    background: transparent;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .copy-btn:hover,
  .copy-btn.copied {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .copy-btn svg {
    width: 15px;
    height: 15px;
  }

  .contact-form {
    display: flex;
    gap: 6px;
    max-width: 680px;
    margin: 22px auto 0;
    padding: 6px;
    border-radius: 999px;
    border: 1px solid rgba(21, 18, 14, 0.2);
    background: rgba(255, 255, 255, 0.45);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .contact-form:focus-within {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(21, 18, 14, 0.08);
  }
  .contact-form input {
    flex: 1 1 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    padding: 12px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    outline: none;
  }
  .contact-form input:first-child {
    flex: 0.55 1 0;
    border-right: 1px solid rgba(21, 18, 14, 0.14);
    border-radius: 999px 0 0 999px;
  }
  .contact-form input::placeholder {
    color: #857c6c;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    font: 500 14px var(--font-body);
    padding: 13px 22px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--paper);
    background: var(--ink);
    transition: background 0.25s ease;
  }
  .send svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--ease);
  }
  .send:hover svg {
    transform: translateX(3px);
  }
  .paper :focus-visible {
    outline-color: var(--ink);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 52px;
  }
  .social {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid rgba(21, 18, 14, 0.22);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.3);
    transition:
      color 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.35s var(--ease);
  }
  .social:hover {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
    transform: translateY(-3px);
  }
  .social svg {
    width: 19px;
    height: 19px;
  }

  @media (max-width: 640px) {
    .paper {
      border-radius: 26px;
    }
    .mail-link {
      padding: 18px 24px;
      width: 100%;
      justify-content: center;
    }
    .copy-btn {
      min-height: 46px;
    }
    .avail {
      font-size: 10.5px;
      letter-spacing: 0.08em;
      padding: 8px 14px;
      gap: 10px;
    }
    .contact-form {
      flex-direction: column;
      border-radius: 22px;
      padding: 8px;
    }
    .contact-form input,
    .contact-form input:first-child {
      flex: none;
      border-radius: 0;
      border-right: 0;
      border-bottom: 1px solid rgba(21, 18, 14, 0.14);
      padding: 14px 12px;
    }
    .send {
      justify-content: center;
      margin-top: 6px;
      padding: 15px 22px;
    }
  }
</style>

<script>
  const EMAIL = "d@softmelody.dev";

  const copyBtn = document.getElementById("copy-email");
  const copyLabel = document.getElementById("copy-label");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(EMAIL);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = EMAIL;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
    copyBtn.classList.add("copied");
    if (copyLabel) copyLabel.textContent = "Copied";
    setTimeout(() => {
      copyBtn.classList.remove("copied");
      if (copyLabel) copyLabel.textContent = "Copy";
    }, 2200);
  });

  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(e.target as HTMLFormElement);
    const name = String(data.get("name") ?? "").trim();
    const idea = String(data.get("idea") ?? "").trim();
    const subject = encodeURIComponent(`Project inquiry${name ? ` — ${name}` : ""}`);
    const body = encodeURIComponent(
      `Hi Daniel,\n\n${idea || "I'd like to talk about a project."}\n\n— ${name}`,
    );
    location.href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
  });
</script>
