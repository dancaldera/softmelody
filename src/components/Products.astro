---
import Icon from "./Icon.astro";
import ProductVisual from "./ProductVisual.astro";
import { products, productStats } from "../data/products";

const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="products">
  <div class="wrap">
    <div class="head reveal">
      <div class="sec-head">
        <div class="sec-tag"><span class="led"></span>Products <b>/ 01</b></div>
        <h2 class="sec-title">Built, shipped, and <em>running in production.</em></h2>
        <p class="sec-sub">
          Products built by Softmelody — systems that carry live traffic, real users, and real
          consequences.
        </p>
      </div>
      <dl class="tally">
        <div><dt>Products</dt><dd>{pad(productStats.total)}</dd></div>
        <div><dt>Live</dt><dd>{pad(productStats.live)}</dd></div>
        <div><dt>Open source</dt><dd>{pad(productStats.oss)}</dd></div>
      </dl>
    </div>

    <div class="cards" id="cards">
      {
        products.map((p, i) => (
          <a
            class="card reveal"
            style={`--span:${p.span};--d:${(i % 3) * 0.08}s`}
            href={p.url}
            target="_blank"
            rel="noopener"
            data-note={i}
          >
            <ProductVisual name={p.icon} />
            <div class="body">
              <div class="top">
                <div class="icon">
                  <Icon name={p.icon} />
                </div>
                <h3>{p.name}</h3>
                <span class={`badge ${p.badge.kind}`}>{p.badge.text}</span>
              </div>
              <p>{p.desc}</p>
              <div class="foot">
                <div class="tags">
                  {p.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <span class="go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7M8 7h9v9" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { STRING_NOTES, pluck } from "../scripts/sound";

  const grid = document.getElementById("cards");
  const cards = [...document.querySelectorAll<HTMLElement>(".card")];

  /* Cursor-following light along the card borders. */
  if (grid && matchMedia("(hover: hover)").matches) {
    grid.addEventListener(
      "pointermove",
      (e) => {
        for (const card of cards) {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        }
      },
      { passive: true },
    );
  }

  /* With sound on, each card rings a note of the same chord as the hero strings. */
  cards.forEach((card) => {
    card.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "touch") return;
      const i = Number(card.dataset.note ?? 0);
      const note = STRING_NOTES[i % STRING_NOTES.length]!;
      pluck(note.freq * (i >= STRING_NOTES.length ? 0.5 : 1), 0.32);
    });
  });

  /* Relay: a link that is always about to expire. */
  const countdown = document.querySelector<HTMLElement>("[data-countdown]");
  if (countdown && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const total = Number(countdown.dataset.countdown);
    const bar = countdown.closest(".viz")?.querySelector<HTMLElement>(".drain i");
    let left = total;
    setInterval(() => {
      left = left <= 0 ? total : left - 1;
      countdown.textContent = `${String(Math.floor(left / 60)).padStart(2, "0")}:${String(left % 60).padStart(2, "0")}`;
      bar?.style.setProperty("--left", String(left / total));
    }, 1000);
  }
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: 64px;
  }
  .head .sec-head {
    margin-bottom: 0;
  }
  .tally {
    display: flex;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(243, 238, 230, 0.02);
  }
  .tally div {
    padding: 16px 24px 14px;
  }
  .tally div + div {
    border-left: 1px solid var(--line);
  }
  .tally dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }
  .tally dd {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 38px;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-top: 6px;
    font-variant-numeric: lining-nums;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    --mx: 50%;
    --my: 0px;
    position: relative;
    isolation: isolate;
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    /* Reveal animates `transform` (staggered); hover lifts with `translate`, so neither waits on the other. */
    transition:
      opacity 0.9s var(--ease) var(--d, 0s),
      transform 0.9s var(--ease) var(--d, 0s),
      translate 0.6s var(--ease),
      box-shadow 0.5s ease;
  }
  .card:hover {
    translate: 0 -5px;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 1);
  }
  /* Amber light that follows the cursor around the border… */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      rgba(255, 196, 120, 0.85),
      transparent 62%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  /* …and spills faintly onto the surface. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      520px circle at var(--mx) var(--my),
      rgba(255, 182, 92, 0.07),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .cards:hover .card::before,
  .card:hover::after {
    opacity: 1;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 26px 28px 26px;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 11px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(255, 182, 92, 0.22);
  }
  .icon :global(svg) {
    width: 19px;
    height: 19px;
  }
  h3 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 27px;
    font-weight: 380;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-right: auto;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }
  .badge.live::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 8px var(--live);
    animation: breathe 2.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.35;
    }
  }
  .body p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
    margin-top: 16px;
    text-wrap: pretty;
  }
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 26px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .go {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    color: var(--text);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.5s var(--ease);
  }
  .go svg {
    width: 15px;
    height: 15px;
  }
  .card:hover .go {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    transform: rotate(45deg);
  }

  @media (max-width: 1040px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 36px;
    }
    .card {
      grid-column: span 6;
    }
    .card:nth-child(1),
    .card:nth-child(4),
    .card:last-child {
      grid-column: span 12;
    }
  }
  @media (max-width: 680px) {
    .card {
      grid-column: span 12 !important;
    }
    .body {
      padding: 22px 20px 22px;
    }
    .tally {
      width: 100%;
    }
    .tally div {
      flex: 1;
      padding: 14px 16px 12px;
    }
    .tally dd {
      font-size: 30px;
    }
  }
  @media (max-width: 420px) {
    .top {
      flex-wrap: wrap;
    }
  }
</style>
